# AgriSense inference service settings (copy to .env; never commit .env).
# Trained AgroPest-12 weights. Default: weights/best_yolov8s_agropest12.pt, then weights/best.pt
MODEL_PATH=
# The model was trained at 512 x 512
MODEL_IMGSZ=512
# Lowest confidence returned (the backend counts at PHONE_VISION_MIN_CONFIDENCE)
MODEL_CONF=0.25
MODEL_IOU=0.5
MAX_IMAGE_MB=10
MAX_QUEUE=8
# Shared secret: set the same value as PHONE_VISION_API_KEY in backend/.env
INFERENCE_API_KEY=
