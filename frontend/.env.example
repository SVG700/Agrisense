# Frontend configuration. EVERYTHING here is compiled into the public JS bundle:
# never put API keys, the Supabase service-role key or the admin key in a VITE_* variable.
# (The admin key is typed into the Admin tab at runtime and kept in sessionStorage.)

# Leave blank in dev: Vite proxies /api to http://localhost:4000.
# For a production build, set to the deployed backend origin, e.g. https://api.example.com
VITE_API_URL=
# Dashboard refresh interval (ms)
VITE_POLL_MS=5000
# Optional: adds a "Satellite (Mapbox)" basemap on the Pest Surveillance Map.
# Leave blank to use only the default token-free CARTO/MapLibre basemaps.
# Browser map tokens are public by design: create a URL-restricted public token (pk.*).
VITE_MAPBOX_TOKEN=
