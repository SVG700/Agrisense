# Agrisense edge collector configuration.
# Local:  copy to edge-simulator/.env
# Pi:     /etc/agrisense/edge.env  (owner root:agrisense, chmod 640)
# Comments must be on their own line (systemd EnvironmentFile does not strip inline comments).

# simulator | hardware
AGRISENSE_MODE=simulator
AGRISENSE_API_URL=http://localhost:4000
AGRISENSE_DEVICE_ID=11111111-1111-4111-8111-111111111111
# Must match one of the backend's DEVICE_API_KEYS (leave blank only in backend demo mode)
AGRISENSE_DEVICE_KEY=
# Seconds between captures (300 = 5 min is sensible in the field)
AGRISENSE_INTERVAL=300
# Queue DB + images. Pi service overrides this to /var/lib/agrisense
AGRISENSE_DATA_DIR=./edge-data
# Max queued captures before the oldest are dropped (~1-2 GB of 1080p JPEGs at 1000)
AGRISENSE_MAX_PENDING=1000
AGRISENSE_KEEP_SENT_HOURS=24
AGRISENSE_HTTP_TIMEOUT=60
AGRISENSE_LOG_LEVEL=INFO

# ---- Hardware mode only ----
# bme280 | dht22 | none
AGRISENSE_SENSOR=bme280
AGRISENSE_I2C_BUS=1
AGRISENSE_BME280_ADDRESS=0x76
AGRISENSE_DHT_PIN=D4
AGRISENSE_RESOLUTION=1920x1080
