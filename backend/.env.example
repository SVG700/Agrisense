# =============================================================================
# Agrisense AI backend configuration. Copy to `.env` (never commit `.env`).
#
# Everything is optional in demo mode: with this file empty the API runs with an
# in-memory store, simulated detections for synthetic traps, the rule-based
# advisor and NO authentication. Set DEMO_MODE=false (or NODE_ENV=production)
# to require keys. The server refuses to start on invalid configuration.
# =============================================================================

# --- Server -------------------------------------------------------------------
PORT=4000
# development | production (production forces DEMO_MODE=false unless overridden)
NODE_ENV=development
# Public URL of this API (used to build synthetic trap image URLs)
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS (* is rejected in production)
CORS_ORIGINS=http://localhost:5173
# Set true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting)
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=120000
# Max decoded image size in bytes (default 10 MB)
MAX_IMAGE_BYTES=10485760

# --- Demo mode ----------------------------------------------------------------
# true  = keys optional, unauthenticated access allowed when keys are unset (local demo only)
# false = DEVICE_API_KEYS and ADMIN_API_KEY are required
DEMO_MODE=true

# --- Authentication (min 16 chars each; generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
# Keys accepted from edge devices on POST /api/telemetry, comma-separated. Each entry is either
#   <key>                 accepted for any device_id, or
#   <device-uuid>:<key>   bound: may only submit data for that device (recommended for real Pis)
DEVICE_API_KEYS=
# Key for admin operations (battery override, device registration). Entered in the dashboard Admin tab; never baked into the frontend build.
ADMIN_API_KEY=

# --- Rate limits (per client IP) ---------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_INGEST_MAX=120
RATE_LIMIT_ADMIN_MAX=60

# --- Supabase (blank = in-memory store) ----------------------------------------
SUPABASE_URL=
# Service role key: server-side only. NEVER put this in frontend/.env or any VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=trap-images
# Lifetime of signed image URLs handed to the dashboard (seconds)
SUPABASE_SIGNED_URL_TTL=3600

# --- Vision API (blank = no real inference; synthetic demo traps are still simulated) ---
# roboflow: YOLO_API_URL=https://serverless.roboflow.com/<project>/<version>
# generic : any endpoint following the contract in README.md
VISION_PROVIDER=roboflow
YOLO_API_URL=
YOLO_API_KEY=
# Informational model identifier stored with each detection, e.g. sticky-trap-pests/3
VISION_MODEL_ID=
# Detections below this confidence are kept (shown in UI) but not counted
VISION_MIN_CONFIDENCE=0.5
YOLO_TIMEOUT_MS=15000

# --- Advisory LLM ----------------------------------------------------------------
# auto   = Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else rule engine
# gemini | claude | none = force one (startup fails if its key is missing)
ADVISOR_PROVIDER=auto

# --- Gemini (Google AI Studio key: https://aistudio.google.com/apikey) -----------
GEMINI_API_KEY=
# Check availability for your key with: npm run verify:gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
# Extra attempts on transient errors (429/5xx)
GEMINI_MAX_RETRIES=2

# --- Claude (optional alternative) ------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (lower = faster, cheaper)
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MS=60000
# SDK retries for 408/409/429/5xx and connection errors
CLAUDE_MAX_RETRIES=2
